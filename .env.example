# 所有服务商共用的模型；所选账号需要支持这个模型。
IMAGE_MODEL=gpt-image-2.5-flare

# 放心 API：https://fangxinapi.com/keys
# 选择支持画图模型的画图分组。
FANGXIN_API_KEY=
# TTAPI：https://dashboard.ttapi.io
TT_API_KEY=

# 只填一家就使用这一家；两家都填时放心首选、TT 备用。
# 临时优先 TT 可说“用 TT 画图”，或使用 --provider ttapi。
# 出现符合条件的明确故障才切换备用；状态不明时停止。

# OpenAI 官方（可选）：https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# 其他兼容接口（可选）：地址与 Key 成对填写。
# IMAGE_API_BASE_URL=https://example.com/v1
# IMAGE_API_KEY=
# IMAGE_API_AUTH_TYPE=bearer
# 文档要求专用请求头时使用 api-key 并设置 IMAGE_API_KEY_HEADER。
# IMAGE_API_KEY_HEADER=X-API-Key
# 同一家备用 Key 可填写 FANGXIN_API_KEY1 / TT_API_KEY1 等编号名称。
# IMAGE_API_FALLBACK=off
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
