# 默认使用哪家：fangxin / ttapi / openai / custom。
# 临时切换可用 --provider ttapi，不修改此文件。
IMAGE_API_PROVIDER=fangxin

# 放心 API：https://fangxinapi.com/keys
# 首次使用请选择支持所选画图模型的画图分组。
FANGXIN_API_KEY=
# TTAPI：https://dashboard.ttapi.io
TT_API_KEY=
# OpenAI 官方：https://platform.openai.com/api-keys
OPENAI_API_KEY=

IMAGE_API_MODEL=gpt-image-2.5-flare
# 已知服务的接口地址和认证方式自动匹配，不需要手填。
# 各家模型不同可分别填写 FANGXIN_API_MODEL / TT_API_MODEL / OPENAI_API_MODEL。
# 同一家备用 Key 可填写 FANGXIN_API_KEY1 / TT_API_KEY1 / OPENAI_API_KEY1。

# 其他兼容服务：将 IMAGE_API_PROVIDER 改为 custom，再填写下面的配置。
# IMAGE_API_BASE_URL=https://example.com/v1
# IMAGE_API_KEY=
# IMAGE_API_AUTH_TYPE=bearer
# 如果文档要求专用请求头，改为 api-key 并设置 IMAGE_API_KEY_HEADER。
# IMAGE_API_KEY_HEADER=X-API-Key
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
